<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's icon: the release's llama on its night with an amber band across the bottom, so the debug build
     installed beside the release (applicationIdSuffix .debug) is told apart at a glance. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background_debug" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome_debug" />
</adaptive-icon>
