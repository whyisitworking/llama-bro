<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- the download worker's dataSync service and its permissions come from llamabro-hub-work's manifest (D75) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- voice messages (D76), asked on the first tap of the mic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- voice mode with Interrupt by talking: communication mode, so echo cancellation hears the reply (D147) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- server mode (docs/design/server.md §3): a service that serves with the app in the background, awake, on Wi-Fi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".DemoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.Demo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Demo.Starting"
            android:windowSoftInputMode="adjustNothing">  <!-- the screens pad for the keyboard themselves (imePadding); the window must not resize as well -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- a reply still being written when the app leaves the screen (D59): at most a few minutes, never an idle model -->
        <service
            android:name=".ReplyService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
        <!-- server mode keeps serving with the app in the background; it ends with serving, with Stop in its notification.
             stopWithTask="false" is Android's default, set here so the choice shows: swiping the app away from Recents
             keeps serving (D158) -->
        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local model server" />
        </service>
        <!-- DemoApp provides WorkManager's configuration, so the default startup initializer is removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
