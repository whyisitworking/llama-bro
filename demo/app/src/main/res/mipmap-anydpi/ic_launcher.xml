<?xml version="1.0" encoding="utf-8"?>
<!-- D69: the llama on its night. The foreground is the artwork's llama with the night unblended out, so its glows keep
     their soft edges over the flat night layer; the monochrome layer is the traced outline, in the same frame, for
     themed icons (Android 13+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
