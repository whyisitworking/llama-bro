root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
# Composables are named like types, as Compose's own guidelines say
ktlint_function_naming_ignore_when_annotated_with = Composable
# Short signatures stay on one line; a long one wraps by the line length, and from five parameters always
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 5
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 5

# SVG path data is one unbreakable string per segment
[**/designsystem/**/DemoIcons.kt]
max_line_length = off
ktlint_standard_binary-expression-wrapping = disabled
# A `when` entry with one short statement needs no braces, even when a neighbour is longer
ktlint_standard_when-entry-bracing = disabled
