# Audio contract (F55, D84): run by sdk/scripts/check.sh's contract step on upstream's audio test model with a clip
# spoken at check time (@clip). http-run.py sends upstream a multipart upload, or a data URL it builds in Python for
# lb-attachment placeholders; lb-run sends the bridge the same file as an attachment, by path, descriptor or bytes.
{"id": "a-01-transcribe-path", "endpoint": "transcriptions", "body": {"temperature": "0", "max_tokens": "24"}, "attachments": [{"name": "file", "mime": "audio/wav", "path": "@clip", "via": "path"}], "needs": ["mmproj", "clip"]}
{"id": "a-02-transcribe-fd", "endpoint": "transcriptions", "body": {"temperature": "0", "max_tokens": "24"}, "attachments": [{"name": "file", "mime": "audio/wav", "path": "@clip", "via": "fd"}], "needs": ["mmproj", "clip"]}
{"id": "a-03-transcribe-bytes", "endpoint": "transcriptions", "body": {"temperature": "0", "max_tokens": "24"}, "attachments": [{"name": "file", "mime": "audio/wav", "path": "@clip", "via": "bytes"}], "needs": ["mmproj", "clip"]}
{"id": "a-04-transcribe-language", "endpoint": "transcriptions", "body": {"temperature": "0", "max_tokens": "24", "language": "en"}, "attachments": [{"name": "file", "mime": "audio/wav", "path": "@clip", "via": "path"}], "needs": ["mmproj", "clip"]}
{"id": "a-05-transcribe-stream", "endpoint": "transcriptions", "body": {"temperature": "0", "max_tokens": "24", "stream": "true"}, "attachments": [{"name": "file", "mime": "audio/wav", "path": "@clip", "via": "path"}], "compare": "events", "needs": ["mmproj", "clip"]}
{"id": "a-06-transcribe-no-file", "endpoint": "transcriptions", "body": {"temperature": "0", "max_tokens": "24"}, "attachments": [], "needs": ["mmproj", "clip"]}
{"id": "a-07-chat-audio-path", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": [{"type": "text", "text": "What is said in this clip?"}, {"type": "input_audio", "input_audio": {"data": "lb-attachment:0", "format": "wav"}}]}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": false, "max_tokens": 24}, "attachments": [{"name": "0", "mime": "audio/wav", "path": "@clip", "via": "path"}], "needs": ["mmproj", "clip"]}
{"id": "a-08-chat-audio-bytes-stream", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": [{"type": "text", "text": "What is said in this clip?"}, {"type": "input_audio", "input_audio": {"data": "lb-attachment:0", "format": "wav"}}]}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": true, "max_tokens": 24}, "attachments": [{"name": "0", "mime": "audio/wav", "path": "@clip", "via": "bytes"}], "needs": ["mmproj", "clip"]}
