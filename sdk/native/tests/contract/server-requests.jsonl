# llamabro-server vs upstream llama-server (server-run.sh): the requests an OpenAI or Anthropic client sends,
# streamed and whole, at temperature 0 and seed 42. "task": "embed" lines run on the embedding model only.
# s-27 is not here: an unparseable body gets the server's own 400 message, upstream's parser message differs (D157, F189).
{"id": "s-01-chat", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": "What is the capital of Japan? One word."}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": true, "max_tokens": 96, "chat_template_kwargs": {"enable_thinking": false}}}
{"id": "s-02-chat-whole", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": "Capital of Italy? One word."}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": false, "max_tokens": 48, "chat_template_kwargs": {"enable_thinking": false}}}
{"id": "s-03-chat-tool", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": "What's the weather in Paris?"}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": true, "max_tokens": 96, "chat_template_kwargs": {"enable_thinking": false}, "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Current weather for a city", "parameters": {"type": "object", "properties": {"city": {"type": "string"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}}, "required": ["city"]}}}]}}
{"id": "s-04-chat-tool-whole", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": "Weather in Madrid?"}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": false, "max_tokens": 48, "chat_template_kwargs": {"enable_thinking": false}, "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Current weather for a city", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}]}}
{"id": "s-05-chat-json-schema", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": "Give me a person named Bob who is 30."}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": true, "max_tokens": 96, "chat_template_kwargs": {"enable_thinking": false}, "response_format": {"type": "json_schema", "json_schema": {"name": "person", "schema": {"type": "object", "properties": {"name": {"type": "string"}, "age": {"type": "integer"}}, "required": ["name", "age"]}}}}}
{"id": "s-06-chat-thinking", "endpoint": "chat", "body": {"messages": [{"role": "user", "content": "What is 12 squared?"}], "temperature": 0, "seed": 42, "cache_prompt": false, "stream": true, "max_tokens": 160}}
{"id": "s-07-chat-model-field", "endpoint": "chat", "body": {"model": "gpt-4o-mini", "messages": [{"role": "user", "content": "Name a river."}], "temperature": 0, "seed": 42, "stream": true, "stream_options": {"include_usage": true}, "max_tokens": 32, "chat_template_kwargs": {"enable_thinking": false}}}
{"id": "s-08-cache-turn1", "endpoint": "chat", "body": {"messages": [{"role": "system", "content": "You are terse."}, {"role": "user", "content": "Name a planet."}], "temperature": 0, "seed": 42, "cache_prompt": true, "stream": true, "max_tokens": 48, "chat_template_kwargs": {"enable_thinking": false}}, "compare_timings": ["cache_n", "prompt_n"]}
{"id": "s-09-cache-turn2", "endpoint": "chat", "body": {"messages": [{"role": "system", "content": "You are terse."}, {"role": "user", "content": "Name a planet."}, {"role": "assistant", "content": "Mars."}, {"role": "user", "content": "Another one."}], "temperature": 0, "seed": 42, "cache_prompt": true, "stream": true, "max_tokens": 48, "chat_template_kwargs": {"enable_thinking": false}}, "compare_timings": ["cache_n", "prompt_n"]}
{"id": "s-10-messages", "endpoint": "messages", "body": {"max_tokens": 16, "messages": [{"role": "user", "content": "Name a colour."}], "temperature": 0, "seed": 42, "stream": true, "chat_template_kwargs": {"enable_thinking": false}}, "compare": "events"}
{"id": "s-11-messages-whole", "endpoint": "messages", "body": {"max_tokens": 16, "system": "Be terse.", "messages": [{"role": "user", "content": "Name a fruit."}], "temperature": 0, "seed": 42, "chat_template_kwargs": {"enable_thinking": false}}, "compare": "events"}
{"id": "s-12-messages-tool", "endpoint": "messages", "body": {"max_tokens": 64, "messages": [{"role": "user", "content": "Weather in Lisbon?"}], "tools": [{"name": "get_weather", "description": "Current weather for a city", "input_schema": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}], "temperature": 0, "seed": 42, "stream": true, "chat_template_kwargs": {"enable_thinking": false}}, "compare": "events"}
