{"id": "s-15-responses-whole", "endpoint": "responses", "body": {"input": [{"role": "user", "content": "Name a fruit."}], "max_output_tokens": 16, "temperature": 0, "seed": 42, "chat_template_kwargs": {"enable_thinking": false}}, "compare": "events"}
