From: ours (F145, D67); upstream PR drafted in research/ph/load-cancel/upstream-pr.md, unposted
Subject: server : let the embedder stop a model load through the load progress callback

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 6a57aa8..72e7ade 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1056,6 +1056,7 @@ public:
     server_chat_params chat_params;
 
     server_state_callback_t callback_state = [](server_state, json) -> void {};
+    server_load_abort_callback_t callback_load_abort;
 
     server_context_impl() {
         mtmd_helper_log_set(common_log_default_callback, nullptr);
@@ -1183,6 +1184,10 @@ private:
     static bool load_progress_callback(float progress, void * user_data) {
         auto * d = static_cast<load_progress_data *>(user_data);
         GGML_ASSERT(d);
+        // checked on every call, before the throttle, so a stop lands within one tensor
+        if (d->ctx->callback_load_abort && d->ctx->callback_load_abort()) {
+            return false;
+        }
         // always emit the first and final sample; throttle the rest to one per 200ms
         {
             auto & t_last = d->t_last_load_progress_ms;
@@ -5227,6 +5232,10 @@ void server_context::set_state_callback(server_state_callback_t callback) {
     impl->callback_state = std::move(callback);
 }
 
+void server_context::set_load_abort_callback(server_load_abort_callback_t callback) {
+    impl->callback_load_abort = std::move(callback);
+}
+
 void server_context::set_video_decoder(const mtmd_helper_video_decoder * decoder) {
     impl->init_opt.video_params.decoder = decoder;
 }
diff --git a/tools/server/server-context.h b/tools/server/server-context.h
