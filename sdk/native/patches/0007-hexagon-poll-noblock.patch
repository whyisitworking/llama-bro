From: Llama Bro (F162); upstream's own Windows branch on every platform, nothing posted
Subject: ggml-hexagon: poll with dspqueue_read_noblock on every platform, not only Windows

diff --git a/ggml/src/ggml-hexagon/htp-drv.cpp b/ggml/src/ggml-hexagon/htp-drv.cpp
index 9ae4ea7..8d9609e 100644
--- a/ggml/src/ggml-hexagon/htp-drv.cpp
+++ b/ggml/src/ggml-hexagon/htp-drv.cpp
@@ -183,12 +183,12 @@ AEEResult dspqueue_read(dspqueue_t               queue,
                         uint32_t *               message_length,
                         uint8_t *                message,
                         uint32_t                 timeout_us) {
-#ifdef _WIN32
-    if (timeout_us == 0) {
+    // A zero timeout is a poll (GGML_HEXAGON_OPPOLL): on Android, dspqueue_read logs an error for every empty poll,
+    // tens of thousands of lines a second that drown the app's own log; dspqueue_read_noblock answers without logging.
+    if (timeout_us == 0 && dspqueue_read_noblock_pfn) {
         return dspqueue_read_noblock_pfn(queue, flags, max_buffers, num_buffers, buffers, max_message_length,
-                                     message_length, message);
+                                         message_length, message);
     }
-#endif
     return dspqueue_read_pfn(queue, flags, max_buffers, num_buffers, buffers, max_message_length, message_length,
                              message, timeout_us);
 }
