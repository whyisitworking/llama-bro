From: ours (F155, F156); upstream fact sheet in research/ph/speech-output/, unposted
Subject: mtmd : lfm3a: the depthformer reads each codebook's own table and takes its positions as an input

diff --git a/tools/mtmd/models/lfm3a-gen.cpp b/tools/mtmd/models/lfm3a-gen.cpp
index f5aedac..b538b8f 100644
--- a/tools/mtmd/models/lfm3a-gen.cpp
+++ b/tools/mtmd/models/lfm3a-gen.cpp
@@ -142,14 +142,23 @@ ggml_tensor * mtmd_graph_lfm3a_gen::build_gen_code() {
     ggml_tensor * cur = ggml_add(ctx0, build_mm(model.gen_code_proj_in_w, h_state), model.gen_code_proj_in_b);
     cur = ggml_reshape_2d(ctx0, cur, n_embd, n_cb);
 
-    ggml_tensor * tok = ggml_get_rows(ctx0, ggml_reshape_2d(ctx0, embd_w, n_embd, n_vocab * n_cb), inp_codes);
+    // each codebook's row from its own table: a 3-D get_rows on the weight itself, not on a merged view of it, so a
+    // backend that keeps the weight in its own layout for the logits matmul below (Hexagon's tiles) reads it right
+    ggml_tensor * inp_codes_cb = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, 1, n_cb);
+    ggml_set_name(inp_codes_cb, "inp_codes_cb");
+    ggml_set_input(inp_codes_cb);
+    ggml_tensor * tok = ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, embd_w, inp_codes_cb), n_embd, n_cb);
     tok = ggml_mul(ctx0, tok, inp_mask);
     ggml_tensor * msk = ggml_mul(ctx0, ggml_repeat(ctx0, model.gen_code_mask_embd, cur), ggml_scale_bias(ctx0, inp_mask, -1.0f, 1.0f));
     cur = ggml_add(ctx0, cur, ggml_add(ctx0, tok, msk));
     cb(cur, "depth_inp", -1);
 
     // bidirectional: no mask, no state
-    ggml_tensor * inp_pos = ggml_cast(ctx0, ggml_arange(ctx0, 0.0f, (float) n_cb, 1.0f), GGML_TYPE_I32);
+    // the positions are an input rather than ggml_arange, which some backends (Hexagon) lack: one unsupported op splits
+    // the graph and sends every step through the CPU
+    ggml_tensor * inp_pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_cb);
+    ggml_set_name(inp_pos, "inp_pos_cb");
+    ggml_set_input(inp_pos);
     for (int il = 0; il < n_layer; il++) {
         const auto & layer = model.layers[il];
         cur = build_lfm_layer(cur, layer, eps, il, [&](ggml_tensor * x) {
diff --git a/tools/mtmd/mtmd-subcontext.cpp b/tools/mtmd/mtmd-subcontext.cpp
index 7f13b7f..d6005ff 100644
--- a/tools/mtmd/mtmd-subcontext.cpp
+++ b/tools/mtmd/mtmd-subcontext.cpp
@@ -1715,6 +1715,17 @@ bool mtmd_subcontext::encode(mtmd_subctx_encode_params * params) {
                         } else {
                             mask[i] = 1.0f;
                         }
+                    }
+                    // the depthformer reads each codebook's own table, the feedback embedding the merged one
+                    if (ggml_graph_get_tensor(gf, "inp_codes_cb") != nullptr) {
+                        set_input_i32("inp_codes_cb", codes);
+                        std::vector<int32_t> pos_cb(n_cb);
+                        for (int64_t i = 0; i < n_cb; i++) {
+                            pos_cb[i] = (int32_t) i;
+                        }
+                        set_input_i32("inp_pos_cb", pos_cb);
+                    }
+                    for (int64_t i = 0; i < n_cb; i++) {
                         codes[i] += (int32_t) (i * n_vocab);
                     }
                     set_input_i32("inp_codes", codes);
