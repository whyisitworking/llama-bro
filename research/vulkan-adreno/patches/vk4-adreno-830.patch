diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index d91b75c..6e89e29 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4683,6 +4683,12 @@ vk_device ggml_vk_get_device(size_t idx) {
 
         // Submit at least every 100 nodes, in case there are workloads without as much matmul.
         device->max_nodes_per_submit = 100;
+        // Qualcomm's Android driver loses the device when one submission runs for about a second or more. The flops
+        // cap counts only matmuls, so a prompt batch of a hybrid model (gated delta net) needs a node cap too: on an
+        // Adreno 830, 100 nodes lost the device and 64 did not; 16 costs about 1% of decode
+        if (device->driver_id == vk::DriverId::eQualcommProprietary) {
+            device->max_nodes_per_submit = 16;
+        }
         const char* GGML_VK_MAX_NODES_PER_SUBMIT = getenv("GGML_VK_MAX_NODES_PER_SUBMIT");
         if (GGML_VK_MAX_NODES_PER_SUBMIT != nullptr) {
             uint32_t max_nodes_per_submit = std::stoul(GGML_VK_MAX_NODES_PER_SUBMIT);
@@ -15130,6 +15136,11 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
             flops_cap = 2'000'000'000ULL * ctx->device->shader_core_count;
         }
     }
+    // Qualcomm's Android driver loses the device when one submission runs for about a second or more, and without
+    // integer dot or matrix cores an Adreno 830 does about 120 GFLOPS on large matmuls: 200 GFLOP would take ~1.7 s
+    if (ctx->device->driver_id == vk::DriverId::eQualcommProprietary) {
+        flops_cap = 20'000'000'000ULL;
+    }
     // small graphs gain nothing from splitting, each submit costs CPU time
     uint64_t flops_per_submit = ctx->last_total_flops < 1'000'000'000ULL ? 0 :
         std::clamp(ctx->last_total_flops / 40u, std::min<uint64_t>(100'000'000ULL, flops_cap), flops_cap);
@@ -16370,6 +16381,11 @@ static bool ggml_backend_vk_device_supports_op(ggml_backend_dev_t dev, const ggm
                 if (op->src[5] != nullptr) {
                     return false;
                 }
+                // On Qualcomm's driver a prompt-sized flash attention (32+ queries over 1K+ keys) runs past the
+                // driver's watchdog in one dispatch and loses the device; the MUL_MAT + SOFT_MAX path works
+                if (device->driver_id == vk::DriverId::eQualcommProprietary) {
+                    return false;
+                }
                 bool coopmat2 = device->coopmat2;
                 uint32_t HSK = op->src[1]->ne[0];
                 uint32_t HSV = op->src[2]->ne[0];
